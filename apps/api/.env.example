# --- database (superuser URL is only for migrations and seeding)
CCH_DATABASE_URL=postgresql+asyncpg://cch_api:cch_api_dev@localhost:5433/cch
CCH_WORKER_DATABASE_URL=postgresql+asyncpg://cch_worker:cch_worker_dev@localhost:5433/cch
CCH_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/cch

# --- auth: leave WORKOS_* empty to use the dev identity provider (local only)
CCH_DEV_IDP=true
CCH_WORKOS_CLIENT_ID=
CCH_WORKOS_API_KEY=
CCH_SESSION_IDLE_MINUTES=30
CCH_SESSION_LIFETIME_HOURS=12
CCH_COOKIE_SECURE=false

# --- AI: without a key the gateway runs in labelled offline mode
ANTHROPIC_API_KEY=
CCH_AI_MODEL=claude-opus-5-5
CCH_AI_INFERENCE_GEO=

# --- demo tooling (never enable in production)
CCH_ENABLE_DEMO_RESET=true
